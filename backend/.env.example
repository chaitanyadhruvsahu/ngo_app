# Copy this file to .env for local development. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-random-value
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgres://ngo_app:ngo_app@db:5432/ngo_app

CORS_ALLOWED_ORIGINS=http://localhost:3000

JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14

EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=1
FRONTEND_BASE_URL=http://localhost:3000

# Local dev: print emails to the console instead of sending them.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@ngo-app.example

THROTTLE_AUTH_SENSITIVE=5/min
THROTTLE_AUTH_VERIFY=10/min

LOG_LEVEL=INFO
