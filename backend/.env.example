# Copy this file to .env for local development. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-random-value
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgres://ngo_app:ngo_app@db:5432/ngo_app

# Must match the port `flutter run -d chrome --web-port=...` actually serves on — see
# app/README.md's Getting Started, which pins it to 5173 for exactly this reason.
CORS_ALLOWED_ORIGINS=http://localhost:5173

JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14

EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=1
FRONTEND_BASE_URL=http://localhost:5173

# Local dev: print emails to the console instead of sending them.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@ngo-app.example

THROTTLE_AUTH_SENSITIVE=5/min
THROTTLE_AUTH_VERIFY=10/min

LOG_LEVEL=INFO

# Phase 2 — field encryption for Aadhaar/bank columns (ADR-0008). Generate a real one per
# environment with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes the encrypted columns permanently unreadable — back it up like a secret,
# not like config.
# Comma-separate multiple keys to rotate without downtime (ADR-0010): the FIRST key encrypts new
# writes, every key is tried when decrypting. Procedure: prepend the new key (new,old), deploy,
# run `python manage.py rotate_encryption_key`, then drop the old key once that succeeds.
FIELD_ENCRYPTION_KEY=

# Private storage shared by documents and job photos (ADR-0009).
STORAGE_BACKEND=local
# Optional — defaults to <repo>/backend/document_storage/ if unset.
# DOCUMENT_STORAGE_ROOT=
MAX_UPLOAD_SIZE_MB=10
# For MinIO: see docs/storage-operations.md (build server, then run minio-init).
# Switch STORAGE_BACKEND=s3 to use it. In Docker use http://minio:9000 instead.
S3_BUCKET_NAME=ngo-private
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION_NAME=us-east-1
# Local development only; use scoped service credentials in production.
S3_ACCESS_KEY_ID=ngo-local
S3_SECRET_ACCESS_KEY=ngo-local-storage-only
S3_ADDRESSING_STYLE=path
# For R2 use the account endpoint, region auto, and a private bucket. No public URL.
